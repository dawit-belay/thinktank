# Drizzle / server
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Browser Supabase client (copy from `npx supabase status -o env` when using local stack)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email (optional — notifications are silently skipped if not set)
# Get your API key at https://resend.com
RESEND_API_KEY=
# Override the sender address once you have a verified domain in Resend
EMAIL_FROM=Thinktank <onboarding@resend.dev>
# Public URL used to build links inside emails
NEXT_PUBLIC_APP_URL=http://localhost:3000
